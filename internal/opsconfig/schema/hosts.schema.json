{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "hosts"],
  "properties": {
    "version": {"const": 1},
    "hosts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sshAlias", "platform", "architecture"],
        "properties": {
          "sshAlias": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "platform": {"const": "ubuntu"},
          "architecture": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "allowedRoots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/(?!$)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))[^/]+(?:/[^/]+)*$"}},
          "host": {"type": "string"}, "port": {"type": "integer"}, "user": {"type": "string"}
        }
      }
    }
  }
}
